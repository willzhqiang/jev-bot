# Select exactly one provider. TypeSafe remains the backward-compatible default.
JEV_PROVIDER=openrouter

# OpenRouter configuration.
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# TypeSafe configuration. Use with JEV_PROVIDER=typesafe.
# TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# Set an absolute path if cua-driver is not on PATH.
# CUA_DRIVER_BIN=/absolute/path/to/cua-driver
